<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>hu.bme.mit.spaceship</groupId>
	<artifactId>hu.bme.mit.spaceship</artifactId>
	<version>0.5.0-SNAPSHOT</version>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.release>21</maven.compiler.release>

		<junit.version>5.14.0</junit.version>
		<mockito.version>5.23.0</mockito.version>
		<jacoco.version>0.8.15</jacoco.version>
		<pitest.version>1.30.2</pitest.version>
		<pitest.junit5.version>1.2.3</pitest.junit5.version>

		<!-- test classes PIT runs; override with -Dpit.targetTests=... (quote it in PowerShell) -->
		<pit.targetTests>hu.bme.mit.spaceship.*</pit.targetTests>

		<!-- PIT mutation operators: a group (DEFAULTS, STRONGER, ALL) or a comma-separated list of operators;
		     override with -Dpit.mutators=... (quote it in PowerShell) -->
		<pit.mutators>STRONGER</pit.mutators>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<version>${junit.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-core</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mockito</groupId>
			<artifactId>mockito-junit-jupiter</artifactId>
			<version>${mockito.version}</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.16.0</version>
			</plugin>

			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.5.5</version>
			</plugin>

			<!-- Line/branch coverage: report is written to target/site/jacoco/index.html after `mvn test` -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>${jacoco.version}</version>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
						<configuration>
							<!-- every run starts fresh, so earlier runs never add coverage -->
							<append>false</append>
						</configuration>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>

			<!-- Mutation testing: `mvn test-compile org.pitest:pitest-maven:mutationCoverage`
			     report is written to target/pit-reports/index.html (and mutations.xml) -->
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>${pitest.version}</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>${pitest.junit5.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetClasses>
						<param>hu.bme.mit.spaceship.*</param>
					</targetClasses>
					<targetTests>
						<param>${pit.targetTests}</param>
					</targetTests>
					<mutators>${pit.mutators}</mutators>
					<outputFormats>
						<outputFormat>HTML</outputFormat>
						<outputFormat>XML</outputFormat>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<!-- Measure only the generated tests (coverage + PIT): `mvnw test -Pllm` -->
		<profile>
			<id>llm</id>
			<properties>
				<test>GT4500LlmTest</test>
				<pit.targetTests>hu.bme.mit.spaceship.GT4500LlmTest</pit.targetTests>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<executions>
							<execution>
								<id>pit</id>
								<phase>test</phase>
								<goals>
									<goal>mutationCoverage</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>

		<!-- Compile and run only the generated tests, no coverage, no PIT: `mvnw test -Pcheck` -->
		<profile>
			<id>check</id>
			<properties>
				<test>GT4500LlmTest</test>
				<jacoco.skip>true</jacoco.skip>
			</properties>
		</profile>
	</profiles>
</project>
